      "actions": {
        "Config_cur": {
          "runAfter": {},
          "type": "Compose",
          "inputs": {
            "SiteUrl": "https://esriis.sharepoint.com/sites/lrsworkspace",
            "KeywordsList": "a7bd004b-84e0-408f-b32d-3f1d791e2af6",
            "DigestFolder": "/Shared Documents",
            "DigestName": "Keyword_Curation_Digest.md",
            "MaxProposals": 20,
            "CurationPromptVersion": "v1.0"
          }
